# Imagen de desarrollo — Vite con HMR
# No usar en produccion.
#
# El codigo fuente se monta como volumen en docker-compose.yml:
#   - ./apps/erp-portal-web:/app        (codigo del host)
#   - web_node_modules:/app/node_modules (deps del contenedor, no del host)
#
# vite.config.ts tiene server.host = true para que Vite escuche en 0.0.0.0
# y el host pueda acceder a http://localhost:5173.
FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev:web"]
