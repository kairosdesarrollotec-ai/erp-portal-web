{
  "name": "kairos-erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "verify:manifest": "node scripts/verify-prototype-manifest.mjs"
  },
  "devDependencies": {
    "js-yaml": "^5.4.2"
  }
}
