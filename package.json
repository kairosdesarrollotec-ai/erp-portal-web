{
  "name": "kairos-erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:web:e2e": "npm run build:e2e --workspace apps/web",
    "preview:web": "npm run preview --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "test:e2e": "npm run build:web:e2e && playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "verify:manifest": "node scripts/verify-prototype-manifest.mjs",
    "audit:prod": "node scripts/audit-check.mjs",
    "audit:all": "node scripts/audit-check.mjs --include-dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.2.4",
    "ajv": "^8.20.0",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.10",
    "firebase": "^12.19.0",
    "lucide-react": "^0.446.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.5",
    "@playwright/test": "^1.47.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.1",
    "msw": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
