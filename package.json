{
  "name": "kairos-erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:web:e2e": "npm run build:e2e --workspace apps/web",
    "preview:web": "npm run preview --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "verify:manifest": "node scripts/verify-prototype-manifest.mjs",
    "audit:prod": "node scripts/audit-check.mjs",
    "audit:all": "node scripts/audit-check.mjs --include-dev"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@playwright/test": "^1.47.0",
    "js-yaml": "^5.4.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
