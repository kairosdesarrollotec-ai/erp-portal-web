VITE_API_BASE_URL=http://localhost:3000

# Firebase (cliente) - Auth / MFA.
# Igual que en el backend: el codigo no distingue entre proyecto Firebase
# de desarrollo o productivo, solo el valor de estas variables. Mientras
# no exista un proyecto de desarrollo propio, pueden apuntar directo al
# proyecto productivo - nunca commitear valores reales, solo van en el
# .env local (gitignorado).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
