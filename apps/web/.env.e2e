# Variables de entorno para el modo E2E (vite build --mode e2e).
# Las llamadas reales a Firebase y al backend son interceptadas por
# page.route() en los tests de Playwright -- estos valores son placeholders.
VITE_FIREBASE_API_KEY=fake-api-key-e2e
VITE_FIREBASE_AUTH_DOMAIN=fake-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fake-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:fake-app-id
VITE_API_BASE_URL=http://localhost:3000
